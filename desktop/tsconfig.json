{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
    ,"baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "electron", "tests", "vite.config.ts"]
}
