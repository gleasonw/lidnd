{
  "name": "lidnd-desktop",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.19.0" },
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "dev": "pnpm build:main && concurrently -k -n vite,main,electron \"vite --host 127.0.0.1\" \"pnpm dev:main\" \"wait-on http://127.0.0.1:5173 && nodemon --watch dist/main.mjs --watch electron/preload.cjs --exec 'pnpm dev:electron'\"",
    "dev:main": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node20 --external:electron --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --outfile=dist/main.mjs --watch",
    "dev:electron": "cp electron/preload.cjs dist/preload.cjs && LIDND_DEV_URL=http://127.0.0.1:5173 electron .",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node20 --external:electron --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --outfile=dist/main.mjs && cp electron/preload.cjs dist/preload.cjs && rm -rf dist/drizzle && cp -r drizzle dist/drizzle",
    "build": "tsc --noEmit && vite build && pnpm build:main",
    "db:generate": "drizzle-kit generate",
    "smoke:ux": "node scripts/walkthrough.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "electron": "^38.0.0",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wait-on": "^9.5.1"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}
