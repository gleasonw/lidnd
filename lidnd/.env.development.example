# Copy this file to .env and run `pnpm dev:mock`.
#
# This gives you a fully working local app — Postgres + an S3-compatible
# store both run in Docker via docker-compose.yml — with no real AWS
# account and no Discord app registration required. Login uses a seeded
# dummy user instead of the real Discord OAuth flow.
#
# Do NOT set these values in any real (staging/production) environment.

DATABASE_URL="postgresql://will:localdev@localhost:5433/dnd"

# Enables the /api/dev-login bypass and the "Log in as test user" button.
# This must never be set in production - see README.md#dev-test-mode.
DEV_LOGIN_ENABLED="true"

# Discord OAuth isn't used in dev mode, but the app reads these at import
# time, so they need to be set to *something*.
CLIENT_ID="dev"
CLIENT_SECRET="dev"

# Points the AWS SDK at the local MinIO container instead of real AWS.
AWS_ENDPOINT_URL="http://localhost:9000"
AWS_BUCKET_NAME="lidnd-dev-assets"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="devkey"
AWS_SECRET_ACCESS_KEY="devsecret123"
